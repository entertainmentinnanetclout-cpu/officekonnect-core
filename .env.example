# OfficeKonnect canonical Supabase backend
#
# The browser-safe URL/publishable key below are optional overrides because the
# canonical values are compiled into the app as public defaults. A fresh clone
# can therefore render/authenticate without first copying environment variables.
#
# Set these when intentionally pointing a deployment at another Supabase project.
SUPABASE_PROJECT_ID="ydgsmnzcwkrlghlhtpgq"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_3rvwowtT4tDS8Ko_oE5v1A_aTdlx8Rp"
SUPABASE_URL="https://ydgsmnzcwkrlghlhtpgq.supabase.co"

VITE_SUPABASE_PROJECT_ID="ydgsmnzcwkrlghlhtpgq"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_3rvwowtT4tDS8Ko_oE5v1A_aTdlx8Rp"
VITE_SUPABASE_URL="https://ydgsmnzcwkrlghlhtpgq.supabase.co"

# Required only by privileged server-only jobs/admin operations.
# Never expose this value through VITE_* or commit the real key.
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-secret"

# Optional Phase 1 development identity bootstrap.
# Server-only. Never prefix the email/password values with VITE_.
# The bootstrap is forcibly disabled on Vercel production deployments.
OFFICEKONNECT_DEV_ACCESS="false"
OFFICEKONNECT_DEV_EMAIL="developer@example.com"
OFFICEKONNECT_DEV_PASSWORD="replace-with-a-development-only-password"
