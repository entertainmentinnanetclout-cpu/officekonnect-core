# Supabase server/runtime configuration
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_URL="https://your-project-ref.supabase.co"

# Browser-safe Supabase configuration
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Phase 1 development identity bootstrap
# Server-only. Never prefix the email/password values with VITE_.
# The bootstrap is forcibly disabled on Vercel production deployments.
OFFICEKONNECT_DEV_ACCESS="false"
OFFICEKONNECT_DEV_EMAIL="developer@example.com"
OFFICEKONNECT_DEV_PASSWORD="replace-with-a-development-only-password"
